{
  "$schema": "https://opencode.ai/config.json",

  // GPT Luna para o trabalho cotidiano; delega tarefas complexas ao heavy.
  "model": "openai/gpt-6-luna",
  "small_model": "openai/gpt-6-luna",

  // Agente geral nativo; agentes especializados são selecionados quando necessário.
  "default_agent": "build",

  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-6-luna",
      "prompt": "Você é o agente principal e deve executar diretamente a maioria das tarefas. Delegue para o agente `heavy` quando houver debugging complexo ou causa raiz incerta; a solução exigir raciocínio arquitetural; for necessário compreender muitas partes do sistema antes de alterar código; houver uma refatoração grande ou de alto risco; existirem múltiplas soluções com trade-offs importantes; ou você já tiver tentado resolver o problema sem chegar a uma solução confiável. Não delegue tarefas rotineiras como CRUDs, DTOs, mapeamentos, testes simples, pequenas correções, alterações localizadas, boilerplate ou explicações simples de código. Quando delegar, forneça ao `heavy` todo o contexto necessário e use a resposta dele para continuar a implementação. Você pode ser instruído explicitamente a usar ou não usar o `heavy`.",
    }
  },

  "instructions": ["AGENTS.md"],

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "edit": "allow",

    "bash": {
      "*": "ask",

      // Comandos de inspeção sem efeitos colaterais.
      "pwd": "allow",
      "echo *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git stash list*": "allow",

      // Preparação de commit: ainda permite revisar o staged diff.
      "git add *": "allow",

      // Verificações do projeto.
      "npm run type-check": "allow",
      "npm run test:unit": "allow",
      "npm run build": "allow",

      // Ações com alteração relevante ou publicação.
      "git commit *": "ask",
      "git push *": "ask",
      "npm run lint": "ask",

      // Operações destrutivas.
      "rm *": "deny",
      "rm -rf *": "deny",
      "git reset *": "ask",
      "git clean *": "deny",
      "git force-*": "deny"
    },

    "skill": {
      "*": "allow"
    }
  }
}
