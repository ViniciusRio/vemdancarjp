# =========================================================
# Copie para .env.local e preencha. NUNCA versione as chaves.
#   source config/.env.local
# =========================================================

# ---------- Modelos ----------
# GPT Luna e GPT Sol são configurados pelo provider do OpenCode.
# Use /connect e /models no OpenCode para autenticar e selecionar o modelo.

# ---------- Penpot ----------
# Self-host local sobe em http://localhost:9001
export PENPOT_BASE_URL="http://localhost:9001"
# Chave gerada em: Sua conta -> Integracoes -> MCP Server (mostrada uma unica vez)
export PENPOT_MCP_KEY="..."
# URL remota do MCP, no formato documentado pela Penpot
export PENPOT_MCP_URL="${PENPOT_BASE_URL}/mcp/stream?userToken=${PENPOT_MCP_KEY}"


# =========================================================
