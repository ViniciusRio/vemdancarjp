# =========================================================
# Copie para .env.local e preencha. NUNCA versione as chaves.
#   source config/.env.local
# =========================================================

# ---------- Kimi K3 (Moonshot) ----------
# Chave criada em platform.kimi.ai (ou platform.kimi.com).
export MOONSHOT_API_KEY="sk-..."

# Uso do K3 via endpoint Anthropic-compativel (Claude Code e afins).
# Confirme a base atual no console; ha duas rotas documentadas:
#   plano/membership: https://api.kimi.com/coding/
#   pay-as-you-go:    https://api.moonshot.ai/anthropic
export KIMI_ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"

# ---------- GLM 5.2 (Z.ai / Zhipu) ----------
# Chave do GLM Coding Plan no console da Z.ai.
export ZAI_API_KEY="..."
# Endpoint OpenAI-compativel (usado pelo OpenCode)
export ZAI_OPENAI_BASE_URL="https://api.z.ai/api/paas/v4"
# Endpoint Anthropic-compativel (usado por clientes que falam Messages API)
export ZAI_ANTHROPIC_BASE_URL="https://api.z.ai/api/anthropic"

# ---------- Penpot ----------
# Self-host local sobe em http://localhost:9001
export PENPOT_BASE_URL="http://localhost:9001"
# Chave gerada em: Sua conta -> Integracoes -> MCP Server (mostrada uma unica vez)
export PENPOT_MCP_KEY="..."
# URL remota do MCP, no formato documentado pela Penpot
export PENPOT_MCP_URL="${PENPOT_BASE_URL}/mcp/stream?userToken=${PENPOT_MCP_KEY}"


# =========================================================
# Perfis de troca rapida de modelo para clientes que falam
# a Messages API da Anthropic (ex.: Claude Code):
#   use_glm  -> GLM 5.2
#   use_kimi -> Kimi K3
# Cole no seu .zshrc/.bashrc se quiser os atalhos sempre a mao.
# =========================================================
use_glm() {
  export ANTHROPIC_BASE_URL="$ZAI_ANTHROPIC_BASE_URL"
  export ANTHROPIC_API_KEY="$ZAI_API_KEY"
  echo "motor: GLM 5.2 (Z.ai)"
}

use_kimi() {
  export ANTHROPIC_BASE_URL="$KIMI_ANTHROPIC_BASE_URL"
  export ANTHROPIC_API_KEY="$MOONSHOT_API_KEY"
  echo "motor: Kimi K3 (Moonshot)"
}
